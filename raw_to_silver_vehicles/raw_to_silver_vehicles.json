{
  "name" : "raw_to_silver_vehicles",
  "jobMode" : "SCRIPT",
  "description" : "Transform vehicle sales data from S3 RAW to SILVER using AWS Glue",
  "role" : "arn:aws:iam::281851731265:role/glue-s3fullacess-role",
  "executionProperty" : {
    "maxConcurrentRuns" : 1
  },
  "command" : {
    "name" : "glueetl",
    "scriptLocation" : "s3://aws-glue-assets-281851731265-ap-south-1/scripts/raw_to_silver_vehicles.py",
    "pythonVersion" : "3"
  },
  "defaultArguments" : {
    "--enable-metrics" : "",
    "--enable-spark-ui" : "true",
    "--job-bookmark-option" : "job-bookmark-enable",
    "--enable-job-insights" : "true",
    "--job-language" : "python",
    "--conf" : "spark.sql.catalog.glue_catalog.glue.skip-name-validation=true --conf spark.eventLog.rolling.enabled=true"
  },
  "maxRetries" : 1,
  "allocatedCapacity" : 2,
  "timeout" : 30,
  "maxCapacity" : 2.0,
  "glueVersion" : "5.0",
  "numberOfWorkers" : 2,
  "workerType" : "G.1X",
  "executionClass" : "STANDARD",
  "sourceControlDetails" : {
    "provider" : "GITHUB",
    "repository" : "automative_repo",
    "branch" : "main",
    "folder" : "raw_to_silver_vehicles"
  }
}